{
  "name": "@cvtoolman/huawei-obs-cli",
  "version": "0.2.0",
  "description": "Operate Huawei Cloud OBS (Object Storage Service) from the command line — built for AI coding assistants.",
  "type": "module",
  "bin": {
    "obs-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:skill": "node scripts/verify-skill.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "huawei",
    "obs",
    "object-storage",
    "cli",
    "ai",
    "skill",
    "agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "esdk-obs-nodejs": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.8"
  }
}
